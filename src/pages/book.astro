---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { site } from "../data/site";

const tips = [
	"The service you're interested in (see Services & Pricing)",
	"A few days or times that work for you",
	"Home studio in Fort Collins, or mobile to your location",
];
---

<Layout
	title="Book a Massage"
	description="Reach out by email or phone to book a massage session with Sacred Ground Bodywork in Fort Collins, northern Colorado, or the Denver metro."
>
	<section class="bg-brand-navy text-brand-cream">
		<div class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-24">
			<h1 class="font-heading text-4xl font-semibold sm:text-5xl">Book a Massage</h1>
			<p class="mt-5 font-body text-lg leading-relaxed text-brand-cream/90">
				Online booking is on its way. For now, the fastest way to grab a time is to email or
				call directly &mdash; I'll get back to you quickly.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
		<div class="grid gap-8 sm:grid-cols-2">
			<div class="flex flex-col rounded-3xl border border-brand-sage/50 bg-white/60 p-8 shadow-sm">
				<h2 class="font-heading text-2xl font-semibold text-brand-navy">Email</h2>
				<p class="mt-3 flex-1 font-body leading-relaxed text-brand-navy/80">
					Send a message with a bit about what you're looking for, and I'll reply with
					availability.
				</p>
				<Button href={site.mailtoBooking} variant="primary" class="mt-6 self-start">
					Email {site.email}
				</Button>
			</div>
			<div class="flex flex-col rounded-3xl border border-brand-sage/50 bg-white/60 p-8 shadow-sm">
				<h2 class="font-heading text-2xl font-semibold text-brand-navy">Call or Text</h2>
				<p class="mt-3 flex-1 font-body leading-relaxed text-brand-navy/80">
					Prefer to talk it through? Give me a call or send a text and we'll find a time
					that works.
				</p>
				<Button href={site.phoneHref} variant="secondary" class="mt-6 self-start">
					Call {site.phone}
				</Button>
			</div>
		</div>

		<div class="mt-10 rounded-3xl bg-brand-sage/20 p-8">
			<h3 class="font-heading text-lg font-semibold text-brand-navy">
				A few things that help me get back to you faster
			</h3>
			<ul class="mt-4 space-y-2">
				{
					tips.map((tip) => (
						<li class="flex items-start gap-3 font-body text-brand-navy/80">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-rust" />
							{tip}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Studio location -->
	<section class="bg-brand-sage/20">
		<div class="mx-auto max-w-5xl px-6 py-16 text-center sm:py-20">
			<h2 class="font-heading text-2xl font-semibold text-brand-navy sm:text-3xl">
				Home Studio Location
			</h2>
			<p class="mt-4 font-body text-brand-navy/80">
				<a href={site.addressMapHref} target="_blank" rel="noopener noreferrer" class="underline decoration-brand-rust decoration-2 underline-offset-4 hover:text-brand-rust">
					{site.address}
				</a>
			</p>
			<p class="mt-2 font-body text-sm text-brand-navy/60">
				Mobile visits available across {site.serviceArea}.
			</p>
		</div>
	</section>

	<!-- Construction redirect -->
	<section class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
		<p class="font-body text-brand-navy/80">
			Looking for onsite massage for a construction crew instead?
		</p>
		<Button href="/construction" variant="secondary" class="mt-5">
			Visit the Construction Companies Page
		</Button>
	</section>
</Layout>
